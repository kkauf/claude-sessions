#!/bin/bash
# Claude Code Session Picker
# Fast, cross-project session search and resume for Claude Code
#
# Requires: fzf, jq, python3
# Install: copy to PATH and chmod +x

shopt -s nullglob

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CLAUDE_PROJECTS="$HOME/.claude/projects"
UNIFIED_CACHE="$HOME/.claude/.sessions-unified-cache.tsv"
SNAPSHOT_FILE="$HOME/.claude/.session-snapshot.tsv"

# Derive home directory key (how Claude Code encodes paths)
HOME_KEY=$(echo "$HOME" | sed 's|/|-|g; s|^-||')

# Resolve the claude binary up-front. claude-sessions runs as bash, usually
# spawned from an interactive zsh; the binary may live in any of several
# install locations (homebrew/npm, native installer) and the inherited PATH
# may be missing some of them in non-login shells.
CLAUDE_BIN="$(command -v claude || true)"
if [[ -z "$CLAUDE_BIN" ]]; then
  for candidate in \
    "$HOME/.claude/local/claude" "$HOME/.local/bin/claude" \
    /opt/homebrew/bin/claude /usr/local/bin/claude; do
    [[ -x "$candidate" ]] && { CLAUDE_BIN="$candidate"; break; }
  done
fi

# --- Save/Restore commands ---

if [[ "${1:-}" == "save" ]]; then
  > "$SNAPSHOT_FILE"

  # Find sessions modified in the last 15 minutes (active/open sessions)
  while IFS= read -r f; do
    sid=$(basename "$f" .jsonl)
    sid=$(basename "$f" .jsonl)
    cwd=$(head -1 "$f" | jq -r '.cwd // empty' 2>/dev/null)
    # Get session name/title from custom-title or first user message
    title=$(grep -m1 '"custom-title"' "$f" 2>/dev/null | jq -r '.title // empty' 2>/dev/null)
    if [[ -z "$title" ]]; then
      title=$(grep -m1 '"user"' "$f" 2>/dev/null | jq -r '
        if .message.content | type == "array" then
          [.message.content[] | select(.type == "text") | .text] | join(" ")
        elif .message.content | type == "string" then
          .message.content
        else ""
        end' 2>/dev/null | head -c 80)
    fi
    [[ -z "$cwd" ]] && continue
    printf '%s\t%s\t%s\n' "$sid" "$cwd" "$title" >> "$SNAPSHOT_FILE"
  done < <(find "$CLAUDE_PROJECTS" -name '*.jsonl' -not -name 'agent-*' -maxdepth 2 -mmin -15 2>/dev/null)

  n=$(wc -l < "$SNAPSHOT_FILE" | tr -d ' ')

  # Build summary for notification
  summary=""
  while IFS=$'\t' read -r sid cwd title; do
    dir=$(basename "$cwd")
    summary+="  $dir — ${title:0:60}"$'\n'
  done < "$SNAPSHOT_FILE"

  echo "Saved $n active sessions."
  [[ -n "$summary" ]] && echo "$summary"

  # macOS notification
  osascript -e "display notification \"$n active sessions saved. Restore with: claude-sessions restore\" with title \"Claude Sessions\" sound name \"Pop\"" 2>/dev/null

  exit 0
fi

if [[ "${1:-}" == "restore" ]]; then
  if [[ ! -f "$SNAPSHOT_FILE" ]]; then
    echo "No snapshot found. Run 'claude-sessions save' first." >&2
    exit 1
  fi

  n=$(wc -l < "$SNAPSHOT_FILE" | tr -d ' ')
  echo "Restoring $n sessions..."
  echo ""

  while IFS=$'\t' read -r sid cwd title; do
    dir=$(basename "$cwd")
    echo "  Opening: $dir — ${title:0:60}"

    if [[ -d "$cwd" ]]; then
      # Open a new iTerm2 tab and resume the session
      osascript -e "
        tell application \"iTerm2\"
          tell current window
            create tab with default profile
            tell current session
              write text \"cd '$cwd' && claude --resume '$sid'\"
            end tell
          end tell
        end tell
      " 2>/dev/null
    else
      echo "    (skipped — directory $cwd not found)"
    fi
  done < "$SNAPSHOT_FILE"

  echo ""
  echo "Done. All sessions restored in new tabs."
  exit 0
fi

if [[ "${1:-}" == "snapshot" ]]; then
  # Show current snapshot without restoring
  if [[ ! -f "$SNAPSHOT_FILE" ]]; then
    echo "No snapshot saved." >&2
    exit 1
  fi
  echo "Saved snapshot:"
  while IFS=$'\t' read -r sid cwd title; do
    dir=$(basename "$cwd")
    echo "  $dir — ${title:0:60}"
  done < "$SNAPSHOT_FILE"
  exit 0
fi

for cmd in fzf jq python3; do
  command -v "$cmd" &>/dev/null || { echo "$cmd required. Install: brew install $cmd (macOS) or apt install $cmd (Linux)" >&2; exit 1; }
done

# --- Helpers ---

# Encode an absolute path the way Claude Code derives project folder names:
# every non-alphanumeric character becomes '-'. (Older versions preserved
# spaces and '~'; matching on the modern scheme also migrates those legacy
# sessions when they're picked.)
encode_path() {
  echo "$1" | sed 's|[^a-zA-Z0-9]|-|g'
}

project_label() {
  local s="${1#-${HOME_KEY}-}"
  s="${s#github-}"
  s="${s##*CloudDocs-Documents-}"
  s="${s##*Documents-}"
  [[ -z "$s" ]] && s="${1#-${HOME_KEY}-}"
  [[ -z "$s" ]] && s="$1"
  echo "$s"
}

current_label() {
  project_label "$(basename "$(echo "$PWD" | sed 's|/|-|g; s|^-||')")"
}

# --- Build/update cache (Python indexer — 40-70x faster than bash) ---
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || realpath "${BASH_SOURCE[0]}")")" && pwd)"
python3 "$SCRIPT_DIR/session_indexer.py" || { echo "Indexer failed" >&2; exit 1; }

if [[ ! -s "$UNIFIED_CACHE" ]]; then
  echo "No sessions found." >&2
  exit 1
fi

session_count=$(wc -l < "$UNIFIED_CACHE" | tr -d ' ')

# --- Derive current project label for tagging ---
CL=$(current_label)

# --- fzf with dynamic FTS5 reload ---
#
# Architecture: Python formats display lines, fzf delegates ALL search to FTS5.
#   --phony: disables fzf's own matching (no fuzzy highlight artifacts)
#   change:reload: every keystroke triggers a FTS5 query via Python
#
# Initial results: pre-scored (if query given) or all by recency.
# Typing replaces the list entirely with fresh FTS5 results.

search_query="${1:-}"

# Generate initial results (Python handles formatting with ANSI colors)
if [[ -n "$search_query" ]]; then
  initial=$(python3 "$SCRIPT_DIR/session_indexer.py" --fzf --label "$CL" --search "$search_query")
  if [[ -z "$initial" ]]; then
    echo "No sessions matched: $search_query" >&2
    exit 1
  fi
else
  initial=$(python3 "$SCRIPT_DIR/session_indexer.py" --fzf --label "$CL")
fi

selected=$(echo "$initial" | fzf \
  --ansi \
  --delimiter='\t' \
  --with-nth=2 \
  --phony \
  --query="$search_query" \
  --no-hscroll \
  --header="$session_count sessions · ctrl-/ toggle preview" \
  --bind="ctrl-/:toggle-preview" \
  --bind="change:reload(python3 '$SCRIPT_DIR/session_indexer.py' --fzf --label '$CL' --search {q} 2>/dev/null || true)" \
  --height=80% \
  --reverse \
  --border \
  --prompt="sessions > " \
  --pointer=">" \
  --color="header:yellow,prompt:blue,pointer:green" \
  --preview="bash '$SCRIPT_DIR/session-preview.sh' {1} '$HOME_KEY' {q}" \
  --preview-window=right:40%:wrap)

if [[ -n "$selected" ]]; then
  session_id=$(echo "$selected" | cut -d$'\t' -f1)

  # Find the session file. claude --resume only finds sessions whose
  # transcript lives in the project folder derived from the CURRENT working
  # directory, so we must cd to the directory that encodes to the folder the
  # file actually lives in — not just any cwd recorded in the transcript
  # (a session that entered a git worktree mid-run is re-homed to the
  # worktree's project folder while its early cwd entries still point at the
  # main repo).
  shopt -s nullglob
  session_files=("$CLAUDE_PROJECTS"/*/${session_id}.jsonl)
  if [[ ${#session_files[@]} -gt 1 ]]; then
    session_file=$(ls -S "${session_files[@]}" 2>/dev/null | head -1)
  elif [[ ${#session_files[@]} -eq 1 ]]; then
    session_file="${session_files[0]}"
  else
    session_file=""
  fi

  if [[ -n "$session_file" && -f "$session_file" ]]; then
    proj_key=$(basename "$(dirname "$session_file")")

    # Distinct cwds recorded in the transcript, in order of first appearance.
    cwds=()
    while IFS= read -r c; do cwds+=("$c"); done < <(
      jq -r '.cwd // empty' "$session_file" 2>/dev/null | awk 'NF && !seen[$0]++')

    # Preferred: the cwd that encodes to the file's own project folder.
    home_cwd=""
    for c in "${cwds[@]}"; do
      if [[ "$(encode_path "$c")" == "$proj_key" ]]; then
        home_cwd="$c"
        break
      fi
    done

    if [[ -n "$home_cwd" && -d "$home_cwd" ]]; then
      cd "$home_cwd"
    else
      # The directory the file is keyed to no longer exists (e.g. a cleaned-up
      # git worktree). Fall back to another surviving cwd from the transcript,
      # or the nearest surviving ancestor, and relocate the transcript into
      # that directory's project folder so claude --resume can find it.
      target=""
      for c in "${cwds[@]}"; do
        [[ -d "$c" ]] && { target="$c"; break; }
      done
      if [[ -z "$target" && ${#cwds[@]} -gt 0 ]]; then
        target="${cwds[0]}"
        while [[ -n "$target" && "$target" != "/" && ! -d "$target" ]]; do
          target="${target%/*}"
        done
        # Don't land inside .claude scaffolding (worktree parents).
        while [[ "$target" == */.claude || "$target" == */.claude/* ]]; do
          target="${target%/*}"
        done
      fi
      if [[ -z "$target" || "$target" == "/" || ! -d "$target" ]]; then
        echo "claude-sessions: the session's directory no longer exists and no fallback was found." >&2
        exit 1
      fi
      target_key=$(encode_path "$target")
      if [[ "$target_key" != "$proj_key" ]]; then
        mkdir -p "$CLAUDE_PROJECTS/$target_key"
        if [[ ! -e "$CLAUDE_PROJECTS/$target_key/$(basename "$session_file")" ]]; then
          mv "$session_file" "$CLAUDE_PROJECTS/$target_key/"
        fi
        echo "claude-sessions: session's original directory is gone; relocated it to resume from $target" >&2
      fi
      cd "$target"
    fi
  fi

  # Last resort: ask the user's login shell, which is where 'claude' is known
  # to resolve (custom PATH, or an install location the candidates above miss).
  # Accept only an absolute path to an executable — reject alias/function defs.
  if [[ -z "$CLAUDE_BIN" ]]; then
    resolved="$("${SHELL:-/bin/zsh}" -lic 'command -v claude' 2>/dev/null | tail -n1)"
    [[ "$resolved" == /* && -x "$resolved" ]] && CLAUDE_BIN="$resolved"
  fi
  if [[ -z "$CLAUDE_BIN" ]]; then
    echo "claude-sessions: could not locate the 'claude' binary." >&2
    echo "  Looked in PATH, ~/.claude/local, ~/.local/bin, /opt/homebrew/bin, /usr/local/bin, and \$SHELL." >&2
    echo "  Install Claude Code or add it to your PATH, then retry." >&2
    exit 1
  fi
  exec "$CLAUDE_BIN" --resume "$session_id"
fi
