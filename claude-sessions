#!/bin/bash
# Claude Code Session Picker
# Fast, cross-project session search and resume for Claude Code
#
# Requires: fzf, jq, python3
# Install: copy to PATH and chmod +x

shopt -s nullglob

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CLAUDE_PROJECTS="${SESSION_PROJECTS_DIR:-$HOME/.claude/projects}"
UNIFIED_CACHE="${SESSION_CACHE_PATH:-$HOME/.claude/.sessions-unified-cache.tsv}"
SNAPSHOT_FILE="$HOME/.claude/.session-snapshot.tsv"

# Derive home directory key (how Claude Code encodes paths)
HOME_KEY=$(echo "$HOME" | sed 's|/|-|g; s|^-||')

# Resolve the claude binary up-front. claude-sessions runs as bash, usually
# spawned from an interactive zsh; the binary may live in any of several
# install locations (homebrew/npm, native installer) and the inherited PATH
# may be missing some of them in non-login shells.
CLAUDE_BIN="$(command -v claude || true)"
if [[ -z "$CLAUDE_BIN" ]]; then
  for candidate in \
    "$HOME/.claude/local/claude" "$HOME/.local/bin/claude" \
    /opt/homebrew/bin/claude /usr/local/bin/claude; do
    [[ -x "$candidate" ]] && { CLAUDE_BIN="$candidate"; break; }
  done
fi

# --- Save/Restore commands ---

if [[ "${1:-}" == "save" ]]; then
  > "$SNAPSHOT_FILE"

  # Find sessions modified in the last 15 minutes (active/open sessions)
  while IFS= read -r f; do
    sid=$(basename "$f" .jsonl)
    sid=$(basename "$f" .jsonl)
    cwd=$(head -1 "$f" | jq -r '.cwd // empty' 2>/dev/null)
    # Get session name/title from custom-title or first user message
    title=$(grep -m1 '"custom-title"' "$f" 2>/dev/null | jq -r '.title // empty' 2>/dev/null)
    if [[ -z "$title" ]]; then
      title=$(grep -m1 '"user"' "$f" 2>/dev/null | jq -r '
        if .message.content | type == "array" then
          [.message.content[] | select(.type == "text") | .text] | join(" ")
        elif .message.content | type == "string" then
          .message.content
        else ""
        end' 2>/dev/null | head -c 80)
    fi
    [[ -z "$cwd" ]] && continue
    printf '%s\t%s\t%s\n' "$sid" "$cwd" "$title" >> "$SNAPSHOT_FILE"
  done < <(find "$CLAUDE_PROJECTS" -name '*.jsonl' -not -name 'agent-*' -maxdepth 2 -mmin -15 2>/dev/null)

  n=$(wc -l < "$SNAPSHOT_FILE" | tr -d ' ')

  # Build summary for notification
  summary=""
  while IFS=$'\t' read -r sid cwd title; do
    dir=$(basename "$cwd")
    summary+="  $dir — ${title:0:60}"$'\n'
  done < "$SNAPSHOT_FILE"

  echo "Saved $n active sessions."
  [[ -n "$summary" ]] && echo "$summary"

  # macOS notification
  osascript -e "display notification \"$n active sessions saved. Restore with: claude-sessions restore\" with title \"Claude Sessions\" sound name \"Pop\"" 2>/dev/null

  exit 0
fi

if [[ "${1:-}" == "restore" ]]; then
  if [[ ! -f "$SNAPSHOT_FILE" ]]; then
    echo "No snapshot found. Run 'claude-sessions save' first." >&2
    exit 1
  fi

  n=$(wc -l < "$SNAPSHOT_FILE" | tr -d ' ')
  echo "Restoring $n sessions..."
  echo ""

  while IFS=$'\t' read -r sid cwd title; do
    dir=$(basename "$cwd")
    echo "  Opening: $dir — ${title:0:60}"

    if [[ -d "$cwd" ]]; then
      # Open a new iTerm2 tab and resume the session
      osascript -e "
        tell application \"iTerm2\"
          tell current window
            create tab with default profile
            tell current session
              write text \"cd '$cwd' && claude --resume '$sid'\"
            end tell
          end tell
        end tell
      " 2>/dev/null
    else
      echo "    (skipped — directory $cwd not found)"
    fi
  done < "$SNAPSHOT_FILE"

  echo ""
  echo "Done. All sessions restored in new tabs."
  exit 0
fi

if [[ "${1:-}" == "snapshot" ]]; then
  # Show current snapshot without restoring
  if [[ ! -f "$SNAPSHOT_FILE" ]]; then
    echo "No snapshot saved." >&2
    exit 1
  fi
  echo "Saved snapshot:"
  while IFS=$'\t' read -r sid cwd title; do
    dir=$(basename "$cwd")
    echo "  $dir — ${title:0:60}"
  done < "$SNAPSHOT_FILE"
  exit 0
fi

for cmd in fzf jq python3; do
  command -v "$cmd" &>/dev/null || { echo "$cmd required. Install: brew install $cmd (macOS) or apt install $cmd (Linux)" >&2; exit 1; }
done

# --- Helpers ---

# Encode an absolute path the way Claude Code derives project folder names:
# every non-alphanumeric character becomes '-'. (Older versions preserved
# spaces and '~'; matching on the modern scheme also migrates those legacy
# sessions when they're picked.)
encode_path() {
  echo "$1" | sed 's|[^a-zA-Z0-9]|-|g'
}

project_label() {
  local s="${1#-${HOME_KEY}-}"
  s="${s#github-}"
  s="${s##*CloudDocs-Documents-}"
  s="${s##*Documents-}"
  [[ -z "$s" ]] && s="${1#-${HOME_KEY}-}"
  [[ -z "$s" ]] && s="$1"
  echo "$s"
}

current_label() {
  project_label "$(basename "$(echo "$PWD" | sed 's|/|-|g; s|^-||')")"
}

# Resolve the directory to resume a session from, relocating the transcript
# if needed. claude --resume only finds transcripts inside the project folder
# derived from the CURRENT working directory, so the invariant we must
# establish is: encode_path(resume dir) == the folder the transcript lives in.
#
# Wrinkles this handles:
#   - A session that entered a git worktree mid-run is re-homed to the
#     worktree's project folder while early cwd entries still point at the
#     main repo — so we can't just cd to the first recorded cwd.
#   - The worktree (or any session dir) may have been deleted since; then we
#     fall back to another surviving cwd from the transcript, or the nearest
#     surviving ancestor, and MOVE the transcript into that dir's folder.
#   - Transcripts stranded under legacy folder encodings (old Claude Code
#     preserved spaces/'~') get migrated to the modern name when picked.
#
# Prints the resume directory on stdout; returns 1 if none can be found.
resolve_resume_dir() {
  local session_id="$1"
  local session_file="" proj_key="" target="" c

  local files=("$CLAUDE_PROJECTS"/*/"${session_id}".jsonl)
  if [[ ${#files[@]} -gt 1 ]]; then
    session_file=$(ls -S "${files[@]}" 2>/dev/null | head -1)
  elif [[ ${#files[@]} -eq 1 ]]; then
    session_file="${files[0]}"
  fi
  # No transcript found (stale index?) — stay where we are and let claude
  # report it; nothing to relocate.
  [[ -z "$session_file" || ! -f "$session_file" ]] && { echo "$PWD"; return 0; }

  proj_key=$(basename "$(dirname "$session_file")")

  # Distinct cwds recorded in the transcript, in order of first appearance.
  local cwds=()
  while IFS= read -r c; do cwds+=("$c"); done < <(
    jq -r '.cwd // empty' "$session_file" 2>/dev/null | awk 'NF && !seen[$0]++')

  # Best case: a still-existing cwd that encodes to the transcript's own
  # folder — cd there, no relocation needed.
  for c in "${cwds[@]}"; do
    if [[ -d "$c" && "$(encode_path "$c")" == "$proj_key" ]]; then
      echo "$c"
      return 0
    fi
  done

  # Otherwise: pick a surviving cwd (first-appearance order puts the launch
  # directory first), or climb to the nearest surviving ancestor.
  for c in "${cwds[@]}"; do
    [[ -d "$c" ]] && { target="$c"; break; }
  done
  if [[ -z "$target" && ${#cwds[@]} -gt 0 ]]; then
    target="${cwds[0]}"
    while [[ -n "$target" && "$target" != "/" && ! -d "$target" ]]; do
      target="${target%/*}"
    done
    # Don't land inside .claude scaffolding (worktree parents).
    while [[ "$target" == */.claude || "$target" == */.claude/* ]]; do
      target="${target%/*}"
    done
  fi
  if [[ -z "$target" || "$target" == "/" || ! -d "$target" ]]; then
    return 1
  fi

  # Relocate the transcript into the target's project folder so claude can
  # see it from there.
  local target_key
  target_key=$(encode_path "$target")
  if [[ "$target_key" != "$proj_key" ]]; then
    mkdir -p "$CLAUDE_PROJECTS/$target_key"
    if [[ ! -e "$CLAUDE_PROJECTS/$target_key/$(basename "$session_file")" ]]; then
      mv "$session_file" "$CLAUDE_PROJECTS/$target_key/"
      echo "claude-sessions: relocated session transcript to resume from $target" >&2
    fi
  fi
  echo "$target"
}

# Locate claude via the user's login shell — where custom PATHs live.
# Accept only an absolute path to an executable; reject alias/function defs.
resolve_claude_bin() {
  [[ -n "$CLAUDE_BIN" ]] && return 0
  local resolved
  resolved="$("${SHELL:-/bin/zsh}" -lic 'command -v claude' 2>/dev/null | tail -n1)"
  [[ "$resolved" == /* && -x "$resolved" ]] && CLAUDE_BIN="$resolved"
  [[ -n "$CLAUDE_BIN" ]]
}

# Test hook: when sourced with CLAUDE_SESSIONS_LIB=1, expose the helpers and
# stop before any indexing/UI work (see test_resume_resolution.sh).
if [[ -n "${CLAUDE_SESSIONS_LIB:-}" ]]; then
  return 0 2>/dev/null || exit 0
fi

# --- open command (headless resume — used by GUI front-ends) ---
# claude-sessions open <sid>          resolve dir, open a terminal via AppleScript
# claude-sessions open <sid> --print  print the resume command instead
# claude-sessions open <sid> --gui    resume via a .command file + LaunchServices.
#     No AppleEvents involved — AppleScript from a GUI app needs an Automation
#     grant tied to its code signature (rotates on ad-hoc rebuilds), which
#     fails silently when missing. SessionPicker.app always uses --gui.
if [[ "${1:-}" == "open" ]]; then
  session_id="${2:-}"
  if [[ -z "$session_id" ]]; then
    echo "usage: claude-sessions open <session-id> [--print|--gui]" >&2
    exit 1
  fi
  if ! resume_dir=$(resolve_resume_dir "$session_id"); then
    echo "claude-sessions: the session's directory no longer exists and no fallback was found." >&2
    exit 1
  fi
  if ! resolve_claude_bin; then
    echo "claude-sessions: could not locate the 'claude' binary." >&2
    exit 1
  fi
  if [[ "${3:-}" == "--print" ]]; then
    printf 'cd %q && %q --resume %q\n' "$resume_dir" "$CLAUDE_BIN" "$session_id"
    exit 0
  fi
  if [[ "${3:-}" == "--gui" ]]; then
    runner_base=$(mktemp -t claude-resume)
    runner="$runner_base.command"
    mv "$runner_base" "$runner"
    {
      echo '#!/bin/bash'
      printf 'rm -f -- %q\n' "$runner"
      printf 'cd %q && exec %q --resume %q\n' "$resume_dir" "$CLAUDE_BIN" "$session_id"
    } > "$runner"
    chmod +x "$runner"
    open "$runner" || { echo "claude-sessions: could not open $runner via LaunchServices." >&2; exit 1; }
    exit 0
  fi
  resume_cmd="cd $(printf '%q' "$resume_dir") && $(printf '%q' "$CLAUDE_BIN") --resume $(printf '%q' "$session_id")"
  if [[ -d /Applications/iTerm.app || -d "$HOME/Applications/iTerm.app" ]]; then
    osascript <<EOF
tell application "iTerm"
    activate
    set newWindow to (create window with default profile)
    tell newWindow
        tell current session
            write text "$resume_cmd"
        end tell
    end tell
end tell
EOF
  else
    osascript <<EOF
tell application "Terminal"
    activate
    do script "$resume_cmd"
end tell
EOF
  fi
  exit 0
fi

# --- Build/update cache (Python indexer — 40-70x faster than bash) ---
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || realpath "${BASH_SOURCE[0]}")")" && pwd)"
python3 "$SCRIPT_DIR/session_indexer.py" || { echo "Indexer failed" >&2; exit 1; }

if [[ ! -s "$UNIFIED_CACHE" ]]; then
  echo "No sessions found." >&2
  exit 1
fi

session_count=$(wc -l < "$UNIFIED_CACHE" | tr -d ' ')

# --- Derive current project label for tagging ---
CL=$(current_label)

# --- fzf with dynamic FTS5 reload ---
#
# Architecture: Python formats display lines, fzf delegates ALL search to FTS5.
#   --phony: disables fzf's own matching (no fuzzy highlight artifacts)
#   change:reload: every keystroke triggers a FTS5 query via Python
#
# Initial results: pre-scored (if query given) or all by recency.
# Typing replaces the list entirely with fresh FTS5 results.

search_query="${1:-}"

# Generate initial results (Python handles formatting with ANSI colors)
if [[ -n "$search_query" ]]; then
  initial=$(python3 "$SCRIPT_DIR/session_indexer.py" --fzf --label "$CL" --search "$search_query")
  if [[ -z "$initial" ]]; then
    echo "No sessions matched: $search_query" >&2
    exit 1
  fi
else
  initial=$(python3 "$SCRIPT_DIR/session_indexer.py" --fzf --label "$CL")
fi

selected=$(echo "$initial" | fzf \
  --ansi \
  --delimiter='\t' \
  --with-nth=2 \
  --phony \
  --query="$search_query" \
  --no-hscroll \
  --header="$session_count sessions · ctrl-/ toggle preview" \
  --bind="ctrl-/:toggle-preview" \
  --bind="change:reload(python3 '$SCRIPT_DIR/session_indexer.py' --fzf --label '$CL' --search {q} 2>/dev/null || true)" \
  --height="${CLAUDE_SESSIONS_HEIGHT:-80%}" \
  --reverse \
  --border \
  --prompt="sessions > " \
  --pointer=">" \
  --color="header:yellow,prompt:blue,pointer:green" \
  --preview="bash '$SCRIPT_DIR/session-preview.sh' {1} '$HOME_KEY' {q}" \
  --preview-window=right:40%:wrap)

if [[ -n "$selected" ]]; then
  session_id=$(echo "$selected" | cut -d$'\t' -f1)

  if ! resume_dir=$(resolve_resume_dir "$session_id"); then
    echo "claude-sessions: the session's directory no longer exists and no fallback was found." >&2
    exit 1
  fi
  cd "$resume_dir"

  # Final invariant: claude --resume, started here, will look for the
  # transcript at exactly this path. If it isn't there, resume WILL fail with
  # 'No conversation found' — self-repair by moving it into place, and say so
  # loudly if even that isn't possible.
  expected="$CLAUDE_PROJECTS/$(encode_path "$PWD")/${session_id}.jsonl"
  if [[ ! -f "$expected" ]]; then
    stray=("$CLAUDE_PROJECTS"/*/"${session_id}".jsonl)
    if [[ ${#stray[@]} -ge 1 && -f "${stray[0]}" ]]; then
      mkdir -p "$(dirname "$expected")"
      mv "${stray[0]}" "$expected"
      echo "claude-sessions: transcript was not where claude expects it; moved it to:" >&2
      echo "  $expected" >&2
    else
      echo "claude-sessions: WARNING — no transcript found for $session_id anywhere under" >&2
      echo "  $CLAUDE_PROJECTS; claude will report 'No conversation found'." >&2
      echo "  The picker index may be stale (deleted session?)." >&2
    fi
  fi

  # Last resort: ask the user's login shell, which is where 'claude' is known
  # to resolve (custom PATH, or an install location the candidates above miss).
  if ! resolve_claude_bin; then
    echo "claude-sessions: could not locate the 'claude' binary." >&2
    echo "  Looked in PATH, ~/.claude/local, ~/.local/bin, /opt/homebrew/bin, /usr/local/bin, and \$SHELL." >&2
    echo "  Install Claude Code or add it to your PATH, then retry." >&2
    exit 1
  fi
  exec "$CLAUDE_BIN" --resume "$session_id"
fi
