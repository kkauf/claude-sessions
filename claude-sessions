#!/bin/bash
# Claude Code Session Picker
# Fast, cross-project session search and resume for Claude Code
#
# Requires: fzf, jq, python3
# Install: copy to PATH and chmod +x

shopt -s nullglob

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CLAUDE_PROJECTS="$HOME/.claude/projects"
UNIFIED_CACHE="$HOME/.claude/.sessions-unified-cache.tsv"

# Derive home directory key (how Claude Code encodes paths)
HOME_KEY=$(echo "$HOME" | sed 's|/|-|g; s|^-||')

for cmd in fzf jq python3; do
  command -v "$cmd" &>/dev/null || { echo "$cmd required. Install: brew install $cmd (macOS) or apt install $cmd (Linux)" >&2; exit 1; }
done

# --- Helpers ---

project_label() {
  local s="${1#-${HOME_KEY}-}"
  s="${s#github-}"
  s="${s##*CloudDocs-Documents-}"
  s="${s##*Documents-}"
  [[ -z "$s" ]] && s="${1#-${HOME_KEY}-}"
  [[ -z "$s" ]] && s="$1"
  echo "$s"
}

current_label() {
  project_label "$(basename "$(echo "$PWD" | sed 's|/|-|g; s|^-||')")"
}

# --- Build/update cache (Python indexer — 40-70x faster than bash) ---
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || realpath "${BASH_SOURCE[0]}")")" && pwd)"
python3 "$SCRIPT_DIR/session_indexer.py" || { echo "Indexer failed" >&2; exit 1; }

if [[ ! -s "$UNIFIED_CACHE" ]]; then
  echo "No sessions found." >&2
  exit 1
fi

session_count=$(wc -l < "$UNIFIED_CACHE" | tr -d ' ')

# --- Derive current project label for tagging ---
CL=$(current_label)

# --- Format for fzf ---
#
# Architecture: 2-field fzf input
#   F1: session_id     (hidden via --with-nth=2)
#   F2: display + 300 spaces padding + search keywords (TF-IDF ordered)
#
# --with-nth=2 hides F1 (SID) and shows only F2.
# The 300-space padding pushes keywords off-screen, but fzf still searches them.
# --no-hscroll prevents fzf from scrolling to show off-screen keyword matches.
#
# Two modes:
#   1. Query provided → Python scores & ranks, fzf is display + selection only (--no-sort)
#   2. No query → fzf does interactive search with --tiebreak=index (recency)
#
# Preview uses bash -c explicitly (fzf defaults to $SHELL which may be zsh).

PAD=$(printf '%300s' '')

# Shared awk formatter: reads 7-field TSV, produces ANSI display lines
awk_format() {
  awk -F'\t' -v cl="$CL" -v mid="$(date -j -v0H -v0M -v0S +%s 2>/dev/null || date -d 'today 0' +%s)" -v pad="$PAD" -v home_key="$HOME_KEY" '
  function reldate(ep,    d) {
    if (ep >= mid) return "today"
    d = int((mid - ep - 1) / 86400) + 1
    if (d == 1) return " 1d  "
    if (d < 7) return sprintf("%2dd  ", d)
    if (d < 30) return sprintf("%2dw  ", int(d/7))
    if (d < 365) return sprintf("%2dmo ", int(d/30))
    return sprintf("%2dy  ", int(d/365))
  }
  {
    sid=$1; title=$2; preview=$3; kw=$4; created=$5; proj=$7

    rd = reldate(created)

    # Project tag (only for other projects)
    tag = ""
    if (proj != cl && proj != "") tag = "  \033[2m\302\267 " proj "\033[0m"

    # Display: date + title or preview + optional project tag
    if (title != "") {
      line = sprintf("\033[33m%-5s\033[0m \033[1m%s\033[0m%s", rd, title, tag)
    } else {
      p = preview
      if (length(p) > 80) p = substr(p, 1, 77) "..."
      line = sprintf("\033[33m%-5s\033[0m %s%s", rd, p, tag)
    }

    # Search text: title > topic boost > keywords > preview > project
    n = split(kw, kw_arr, " ")
    topic = ""
    for (i = 1; i <= 15 && i <= n; i++) topic = topic " " kw_arr[i]
    search = title " " topic " " kw " " preview " " proj
    printf "%s\t%s%s%s\n", sid, line, pad, search
  }'
}

search_query="${1:-}"

if [[ -n "$search_query" ]]; then
  # Python-scored mode: pre-ranked results, fzf is display + selection only
  scored_results=$(python3 "$SCRIPT_DIR/session_indexer.py" --search "$search_query")
  if [[ -z "$scored_results" ]]; then
    echo "No sessions matched: $search_query" >&2
    exit 1
  fi
  scored_count=$(echo "$scored_results" | wc -l | tr -d ' ')

  selected=$(echo "$scored_results" | awk_format | fzf \
    --ansi \
    --delimiter='\t' \
    --with-nth=2 \
    -i \
    --no-hscroll \
    --no-sort \
    --header="$scored_count matches (of $session_count) · ctrl-/ toggle preview" \
    --bind="ctrl-/:toggle-preview" \
    --height=80% \
    --reverse \
    --border \
    --prompt="sessions > " \
    --pointer=">" \
    --color="header:yellow,prompt:blue,pointer:green" \
    --preview="bash '$SCRIPT_DIR/session-preview.sh' {1} '$HOME_KEY' {q}" \
    --preview-window=right:40%:wrap)
else
  # No query: all sessions by recency, fzf does interactive search
  selected=$(awk_format < "$UNIFIED_CACHE" | fzf \
    --ansi \
    --delimiter='\t' \
    --with-nth=2 \
    --exact \
    -i \
    --no-hscroll \
    --tiebreak=index \
    --header="$session_count sessions · ctrl-/ toggle preview" \
    --bind="ctrl-/:toggle-preview" \
    --height=80% \
    --reverse \
    --border \
    --prompt="sessions > " \
    --pointer=">" \
    --color="header:yellow,prompt:blue,pointer:green" \
    --preview="bash '$SCRIPT_DIR/session-preview.sh' {1} '$HOME_KEY' {q}" \
    --preview-window=right:40%:wrap)
fi

if [[ -n "$selected" ]]; then
  session_id=$(echo "$selected" | cut -d$'\t' -f1)

  # Find the session file and extract its original working directory.
  # claude --resume scopes to the current project, so we must cd to the
  # directory the session was created in.
  session_cwd=""
  shopt -s nullglob
  session_files=("$CLAUDE_PROJECTS"/*/${session_id}.jsonl)
  if [[ ${#session_files[@]} -gt 0 && -f "${session_files[0]}" ]]; then
    session_cwd=$(grep -m1 '"cwd"' "${session_files[0]}" \
      | jq -r '.cwd // empty' 2>/dev/null)
  fi

  if [[ -n "$session_cwd" && -d "$session_cwd" ]]; then
    cd "$session_cwd"
  fi

  exec claude --resume "$session_id"
fi
